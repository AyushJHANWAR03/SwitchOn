# Database
DATABASE_URL=postgresql+psycopg://switchon:switchon@localhost:5432/switchon_db

# Kafka/Redpanda
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVENTS=inspection_events
KAFKA_CONSUMER_GROUP=switchon-consumer-group

# API
API_HOST=0.0.0.0
API_PORT=8000

# Thresholds
MIN_EVENTS=5
WINDOW_MINUTES=10
BASELINE_MINUTES=60
COOLDOWN_MINUTES=5

# Alert Thresholds
THRESHOLD_INFO_FACTOR=1.5
THRESHOLD_INFO_ABSOLUTE=0.02
THRESHOLD_WARNING_FACTOR=2.0
THRESHOLD_WARNING_ABSOLUTE=0.05
THRESHOLD_CRITICAL_FACTOR=3.0
THRESHOLD_CRITICAL_ABSOLUTE=0.10
